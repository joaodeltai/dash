# Copie para .env.local (nunca faça commit de .env.local).
# As duas variáveis abaixo são PÚBLICAS por natureza: vão para o bundle do navegador.
# A segurança dos dados vem das políticas RLS do banco, não do sigilo destas chaves.
# NUNCA coloque aqui a service_role / secret key.

# URL do projeto Supabase (Dashboard → Project Settings → API). Local: http://127.0.0.1:55321
VITE_SUPABASE_URL=

# Chave publishable (sb_publishable_...) ou a anon key legada. Local: veja `supabase status`.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional: provedores OAuth habilitados no Supabase Auth, separados por vírgula
# (google, azure, apple). Deixe vazio para mostrar apenas e-mail e senha.
VITE_AUTH_PROVIDERS=
