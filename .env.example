# Copie para .env.local (nunca faça commit de .env.local).
# As duas variáveis abaixo são PÚBLICAS por natureza: vão para o bundle do navegador.
# A segurança dos dados vem das políticas RLS do banco, não do sigilo destas chaves.
# NUNCA coloque aqui a service_role / secret key.

# URL do projeto Supabase (Dashboard → Project Settings → API). Local: http://127.0.0.1:55321
VITE_SUPABASE_URL=

# Chave publishable (sb_publishable_...) ou a anon key legada. Local: veja `supabase status`.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional: provedores OAuth habilitados no Supabase Auth, separados por vírgula
# (google, azure, apple). Deixe vazio para mostrar apenas e-mail e senha.
VITE_AUTH_PROVIDERS=

# --- Segredos do SERVIDOR (Vercel → Settings → Environment Variables). ---
# Não use o prefixo VITE_. O Vite publicaria o valor no JavaScript do site.
# A senha da caixa contato@grupodeltai.com.br NÃO é nenhuma destas variáveis:
# ela é digitada em CRM → E-mail (#/crm/email) e gravada cifrada no banco.
# O passo a passo está em docs/EMAIL.md.

# 32 bytes em base64. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_CREDENTIALS_KEY=

# Chave secreta do Supabase (sb_secret_... ou a service_role legada). Nunca VITE_.
SUPABASE_SECRET_KEY=

# Opcional se VITE_SUPABASE_URL e VITE_SUPABASE_PUBLISHABLE_KEY já existirem na Vercel.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Envio. Só a string true libera, e ainda exige aprovação por mensagem. O padrão é desligado.
EMAIL_SENDING_ENABLED=false

# Leitura periódica. Só a string true liga o endpoint /api/email/cron-sync. O padrão é desligado.
# O cron não está registrado. Ele nunca envia.
EMAIL_READ_SYNC_ENABLED=false

# Segredo de quem chama o cron de leitura, se um dia ele for ligado.
CRON_SECRET=
